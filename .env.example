# --- API KEYS ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# --- MODEL CONFIGURATIONS ---
# Repositori Hugging Face tempat Anda meng-host IndoBERT Model (Public)
INDOBERT_HF_REPO=username/matcha-indobert-intent

# --- PATHS (Gunakan nilai default ini untuk Railway) ---
CHROMA_PATH=./chroma_db
MATCHA_DATA_DIR=./data

# --- DATABASE CONFIGURATION ---
# Diisi otomatis oleh Railway jika menggunakan Railway Postgres Service.
# Untuk lokal/SQLite, kosongkan saja atau arahkan ke berkas lokal.
# DATABASE_URL=postgresql://user:pass@host:port/dbname
MATCHA_DB_PATH=matcha_sessions.db
